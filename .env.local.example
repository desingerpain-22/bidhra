NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key from Supabase (Project Settings -> API). Server-only,
# never exposed to the browser. Used to record/update donation rows.
SUPABASE_SERVICE_ROLE_KEY=

# API key from your NOWPayments account (Settings -> API keys),
# used to create crypto donation invoices.
NOWPAYMENTS_API_KEY=

# IPN secret key from your NOWPayments account (Settings -> IPN), used to
# verify payment status webhooks at /api/nowpayments/ipn.
NOWPAYMENTS_IPN_SECRET=
